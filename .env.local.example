# Supabase (client-safe public values)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# OpenRouter — server-only. Powers the AI request-structuring (Claude Haiku 4.5).
# Optional: without it, the "Structure with AI" button falls back to the manual form.
OPENROUTER_API_KEY=sk-or-...
